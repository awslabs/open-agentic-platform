.platform/
config.local.yaml
private/
.local/
# Local credential scratch files. `.locals` holds live values (gateway virtual
# keys and similar); `.env` is what `.env.example` gets copied to.
.locals
.env

# Dark Factory IAM terraform working files (committed: iam/*.tf; ignored: state/plugins)
gitops/addons/charts/dark-factory/iam/.terraform/
gitops/addons/charts/dark-factory/iam/.terraform.lock.hcl
gitops/addons/charts/dark-factory/iam/terraform.tfstate
gitops/addons/charts/dark-factory/iam/terraform.tfstate.backup
gitops/addons/charts/dark-factory/iam/_provider.tf

# Local session notes. These accumulate live environment detail (account IDs,
# cluster endpoints, image URIs) and are not meant for a public repo.
# .kiro/steering/ IS tracked deliberately; only the handoff notes are ignored.
.kiro/session-handoff*.md
.oap-private/

# Python bytecode and tool caches, anywhere in the repo
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Cedar policies generated by scripts/nitro/gen-cedar-policy.sh. They are a
# build artifact of a specific pod spec -- regenerated whenever a pinned field
# changes -- and belong in the Application that consumes them, not loose in the
# repo root.
*-cedar-policy.b64

# Local agent scratch: session state and git worktrees. The worktrees are real
# git repositories, so a `git add -A` turns them into gitlinks in a commit.
.claude/

# macOS
.DS_Store
