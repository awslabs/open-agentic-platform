# Agent Configuration
AGENT_NAME=strands-agent
AGENT_DESCRIPTION=A Strands agent with A2A protocol support

# System Prompt
SYSTEM_PROMPT=You are a helpful AI assistant with access to various tools and capabilities. You can help with general questions, data analysis, and task automation. Always be clear, concise, and helpful in your responses.

# Model Configuration
MODEL_ID=claude-sonnet
AWS_REGION=us-west-2

# LLM Gateway Configuration (Bifrost AI Gateway)
# The agent uses Bifrost's OpenAI-compatible endpoint (/v1) for model access.
# Bifrost handles Bedrock authentication via Pod Identity.
LLM_GATEWAY_URL=http://bifrost.bifrost.svc.cluster.local:8080/v1
# Bifrost virtual key (sent via the x-bf-vk header). Now REQUIRED: Bifrost
# enforces a virtual key on every inference request (is_vk_mandatory /
# enforceAuthOnInference are enabled). On the platform the agent component mints
# a per-agent VK and injects it here from the <agent>-llm-vk Secret; set this
# manually only for local/off-platform runs.
LLM_GATEWAY_API_KEY=

# MCP Servers (comma-separated URLs)
# MCP_SERVERS=http://mcp-server-1:3000,http://mcp-server-2:3001

# Server Configuration
PORT=8083
HOST=0.0.0.0
LOG_LEVEL=INFO
