{
  "title": "Agent Evaluation",
  "uid": "agent-evaluation",
  "tags": [
    "agent-evaluation",
    "agent-platform"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "1m",
  "links": [
    {
      "title": "Langfuse traces",
      "type": "link",
      "icon": "external link",
      "tooltip": "Drill into scored traces and the judge's reasoning",
      "url": "https://<ingress_domain>/",
      "targetBlank": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus"
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(oap_agent_eval_info, cluster)",
          "refId": "cluster"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(oap_agent_eval_info{cluster=~\"$cluster\"}, namespace)",
          "refId": "namespace"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "agent",
        "label": "Agent",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(oap_agent_eval_info{cluster=~\"$cluster\",namespace=~\"$namespace\"}, agent)",
          "refId": "agent"
        },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "window",
        "label": "Window",
        "type": "custom",
        "query": "24h,7d",
        "current": {
          "text": "7d",
          "value": "7d"
        },
        "options": [
          {
            "text": "24h",
            "value": "24h",
            "selected": false
          },
          {
            "text": "7d",
            "value": "7d",
            "selected": true
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Agent: $agent",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Pass rate by evaluator ($window)",
      "description": "Share of scored traces at or above the evaluator's threshold for this agent's strictness. Red below the 90% pass-rate target.",
      "gridPos": {
        "h": 6,
        "w": 10,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "oap_agent_eval_pass_ratio{cluster=~\"$cluster\",namespace=~\"$namespace\",agent=\"$agent\",window=\"$window\"}",
          "legendFormat": "{{evaluator}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.9
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Scored traces ($window)",
      "description": "How many sampled traces the judge scored, so a pass rate always reads as 'x% of N'.",
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 10,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(oap_agent_eval_scores{cluster=~\"$cluster\",namespace=~\"$namespace\",agent=\"$agent\",window=\"$window\"})",
          "legendFormat": "scored",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Evaluation settings",
      "description": "Levels and models from the agent's evaluation block.",
      "gridPos": {
        "h": 6,
        "w": 10,
        "x": 14,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "oap_agent_eval_info{cluster=~\"$cluster\",namespace=~\"$namespace\",agent=\"$agent\"}",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "namespace": true,
              "agent": true
            },
            "renameByName": {
              "gen_ai_request_model": "Agent model",
              "eval_ai_request_model": "Judge",
              "strictness": "Strictness",
              "coverage": "Coverage"
            }
          }
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Pass rate over time (24h window)",
      "description": "Dashed line: 90% pass-rate target.",
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "oap_agent_eval_pass_ratio{cluster=~\"$cluster\",namespace=~\"$namespace\",agent=\"$agent\",window=\"24h\"}",
          "legendFormat": "{{evaluator}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0.5,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "dashed"
            },
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Average score vs threshold ($window)",
      "description": "Bar: mean judge score (0-1). Marker colour changes at this agent's threshold for each evaluator.",
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 14,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "oap_agent_eval_score_avg{cluster=~\"$cluster\",namespace=~\"$namespace\",agent=\"$agent\",window=\"$window\"}",
          "legendFormat": "{{evaluator}} avg",
          "refId": "A",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "oap_agent_eval_pass_threshold{cluster=~\"$cluster\",namespace=~\"$namespace\",agent=\"$agent\"}",
          "legendFormat": "{{evaluator}} threshold",
          "refId": "B",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8e8e8e"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "Fleet",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "table",
      "title": "All agents, lowest pass rate first ($window)",
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sort(oap_agent_eval_pass_ratio{cluster=~\"$cluster\",namespace=~\"$namespace\",window=\"$window\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "window": true
            },
            "indexByName": {
              "namespace": 0,
              "agent": 1,
              "evaluator": 2,
              "Value": 3
            },
            "renameByName": {
              "Value": "Pass rate",
              "namespace": "Namespace",
              "agent": "Agent",
              "evaluator": "Evaluator"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Pass rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.8
                    },
                    {
                      "color": "green",
                      "value": 0.9
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Pass rate",
            "desc": false
          }
        ]
      }
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Pass rate by agent model (7d)",
      "description": "Joins each agent's pass ratio to its model alias from oap_agent_eval_info.",
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 14,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "avg by (gen_ai_request_model, evaluator) (oap_agent_eval_pass_ratio{window=\"7d\"} * on (cluster, namespace, agent) group_left (gen_ai_request_model) oap_agent_eval_info)",
          "legendFormat": "{{gen_ai_request_model}} \u00b7 {{evaluator}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.9
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Evaluation health",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "panels": []
    },
    {
      "id": 11,
      "type": "gauge",
      "title": "Langfuse rules used (limit 50)",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(oap_agent_eval_rules_active)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 50,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 40
              },
              {
                "color": "red",
                "value": 48
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Data age",
      "description": "Seconds since the metrics loop last succeeded. Amber means stale data, not a quality drop.",
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 6,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "time() - oap_agent_eval_last_success_timestamp_seconds{cluster=~\"$cluster\",loop=\"metrics\"}",
          "legendFormat": "{{cluster}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 600
              },
              {
                "color": "red",
                "value": 900
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Reconciler errors (rate, 15m)",
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 26
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (cluster, loop) (rate(oap_agent_eval_errors_total{cluster=~\"$cluster\"}[15m]))",
          "legendFormat": "{{cluster}} {{loop}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "min": 0,
          "custom": {
            "axisSoftMax": 0.1
          }
        },
        "overrides": []
      }
    }
  ]
}
