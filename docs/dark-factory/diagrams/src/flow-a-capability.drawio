<mxfile host="app.diagrams.net" agent="claude-code" version="24.0.0">
  <diagram name="Flow A — Capability" id="flowa">
    <mxGraphModel dx="1700" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="900" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Agent Sandbox capability  ·  a warm pool of Kata micro-VMs, on the hub" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontFamily=Helvetica;fontColor=#16232E;" vertex="1" parent="1">
          <mxGeometry x="70" y="34" width="1400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Shipped as a GitOps addon. An ApplicationSet stands up the operator, the Kata runtime on a nested-virt node group, and a warm pool any workload can claim on demand." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;fontColor=#6B7885;" vertex="1" parent="1">
          <mxGeometry x="72" y="74" width="1550" height="24" as="geometry" />
        </mxCell>

        <!-- ROW 1: GitOps enablement -->
        <mxCell id="gitopsFrame" value="GitOps enablement  ·  ArgoCD app-of-apps" style="rounded=1;arcSize=3;html=1;fillColor=#FFFDF7;strokeColor=#FBA919;strokeWidth=2;dashed=1;dashPattern=8 5;verticalAlign=top;align=left;fontColor=#C77F0A;fontSize=14;fontStyle=1;fontFamily=Helvetica;spacingLeft=18;spacingTop=12;" vertex="1" parent="1">
