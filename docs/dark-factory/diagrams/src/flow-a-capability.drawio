        <mxCell id="flag" value="&lt;b&gt;alwaysSelector&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;environment In [control-plane] → hub&lt;/font&gt;" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#FF9900;strokeColor=none;fontColor=#FFFFFF;fontSize=15;fontFamily=Helvetica;shadow=1;verticalAlign=middle;" vertex="1" parent="1">
