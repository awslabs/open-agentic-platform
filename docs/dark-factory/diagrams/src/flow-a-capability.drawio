        <mxCell id="appset" value="&lt;b&gt;ApplicationSet&lt;/b&gt;  ·  sync waves 0 → 1 → 2&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;operator → kata-deploy → chart&lt;/font&gt;" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D8DFE6;strokeWidth=1.5;fontColor=#16232E;fontSize=15;fontFamily=Helvetica;shadow=1;verticalAlign=middle;" vertex="1" parent="1">
