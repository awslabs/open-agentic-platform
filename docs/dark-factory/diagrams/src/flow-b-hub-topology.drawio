        <mxCell id="t5" value="only :8080" style="html=1;rounded=0;strokeColor=#12C88B;strokeWidth=2.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontColor=#0E9A6C;fontSize=12;fontStyle=1;fontFamily=Helvetica;" edge="1" parent="1" source="coder" target="eval"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="t6" style="html=1;rounded=0;strokeColor=#12C88B;strokeWidth=2.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="eval" target="bifrost"><mxGeometry relative="1" as="geometry" /></mxCell>

