        <mxCell id="eso" value="external-secrets" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#EFAAB8;strokeWidth=1.5;fontColor=#8A2540;fontSize=15;fontFamily=Helvetica;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="860" y="196" width="330" height="60" as="geometry" />
