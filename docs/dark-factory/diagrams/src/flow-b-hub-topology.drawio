<mxfile host="app.diagrams.net" agent="claude-code" version="24.0.0">
  <diagram name="Flow B — Hub topology &amp; isolation" id="hubtopo">
    <mxGraphModel dx="1700" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1080" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Hub topology  ·  three-layer control-plane isolation" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontFamily=Helvetica;fontColor=#16232E;" vertex="1" parent="1">
          <mxGeometry x="70" y="34" width="1200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="The Dark Factory runs on the hub, next to the fleet control plane. Untrusted coder VMs are fenced off by three independent, verified layers — they reach only DNS, Bifrost, and public GitHub." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;fontColor=#6B7885;" vertex="1" parent="1">
          <mxGeometry x="72" y="74" width="1550" height="24" as="geometry" />
        </mxCell>

        <!-- ===== ROW 1: Control plane (fenced off, pink) ===== -->
        <mxCell id="cpFrame" value="Control plane  ·  fenced off from the sandbox" style="rounded=1;arcSize=3;html=1;fillColor=#FFF5F7;strokeColor=#E5677E;strokeWidth=2;dashed=1;dashPattern=8 5;verticalAlign=top;align=left;fontColor=#C23A54;fontSize=14;fontStyle=1;fontFamily=Helvetica;spacingLeft=18;spacingTop=12;" vertex="1" parent="1">
