        <!-- ===== ROW 3: Kata node (data plane) ===== -->
        <mxCell id="kataFrame" value="Tainted nested-virt node  ·  c8i  ·  kata=true:NoSchedule" style="rounded=1;arcSize=3;html=1;fillColor=#FFFBF3;strokeColor=#F0B24A;strokeWidth=2;dashed=1;dashPattern=8 5;verticalAlign=top;align=left;fontColor=#B07A1E;fontSize=14;fontStyle=1;fontFamily=Helvetica;spacingLeft=18;spacingTop=12;" vertex="1" parent="1">
