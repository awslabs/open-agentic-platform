        <!-- ===== ROW 2: Dark Factory lane (orchestration) ===== -->
        <mxCell id="dfFrame" value="Dark Factory lane  ·  orchestration (trusted · holds AWS IAM + GitHub App)" style="rounded=1;arcSize=3;html=1;fillColor=#FFFDF7;strokeColor=#FBA919;strokeWidth=2;dashed=1;dashPattern=8 5;verticalAlign=top;align=left;fontColor=#C77F0A;fontSize=14;fontStyle=1;fontFamily=Helvetica;spacingLeft=18;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="360" width="1580" height="140" as="geometry" />
