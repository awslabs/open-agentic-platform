        <mxCell id="bifrost" value="&lt;b&gt;Bifrost&lt;/b&gt; → Bedrock" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#12C88B;strokeColor=none;fontColor=#FFFFFF;fontSize=15;fontFamily=Helvetica;shadow=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1420" y="628" width="180" height="76" as="geometry" />
        </mxCell>

        <!-- ===== ROW 4: The three isolation layers ===== -->
        <mxCell id="isoFrame" value="Three-layer egress isolation  ·  verified — coder reaches only DNS + Bifrost + public GitHub" style="rounded=1;arcSize=3;html=1;fillColor=#F3FBF8;strokeColor=#12C88B;strokeWidth=2;dashed=1;dashPattern=8 5;verticalAlign=top;align=left;fontColor=#0E9A6C;fontSize=14;fontStyle=1;fontFamily=Helvetica;spacingLeft=18;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="810" width="1580" height="150" as="geometry" />
        </mxCell>
        <mxCell id="l1" value="&lt;b&gt;1 · NetworkPolicy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;pod-IP egress deny&lt;br&gt;(Deployment-owned pods)&lt;/font&gt;" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9FE3C9;strokeWidth=1.5;fontColor=#16232E;fontSize=14;fontFamily=Helvetica;shadow=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="120" y="856" width="470" height="86" as="geometry" />
        </mxCell>
        <mxCell id="l2" value="&lt;b&gt;2 · Admin ClusterNetworkPolicy&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Deny — applies to Sandbox-CR pods&lt;br&gt;(evaluated first, wins)&lt;/font&gt;" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9FE3C9;strokeWidth=1.5;fontColor=#16232E;fontSize=14;fontFamily=Helvetica;shadow=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="620" y="856" width="470" height="86" as="geometry" />
        </mxCell>
        <mxCell id="l3" value="&lt;b&gt;3 · ClusterIP node-firewall&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;conntrack ctorigdst&lt;br&gt;closes VPC-CNI DNAT gap&lt;/font&gt;" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9FE3C9;strokeWidth=1.5;fontColor=#16232E;fontSize=14;fontFamily=Helvetica;shadow=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1120" y="856" width="480" height="86" as="geometry" />
