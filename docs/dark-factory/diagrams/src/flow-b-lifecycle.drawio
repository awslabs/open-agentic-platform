<mxfile host="app.diagrams.net" agent="claude-code" version="24.0.0">
  <diagram name="Flow B — Dark Factory" id="flowb">
    <mxGraphModel dx="1700" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2640" pageHeight="640" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Dark Factory  ·  issue → PR → merge → teardown" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontFamily=Helvetica;fontColor=#16232E;" vertex="1" parent="1">
          <mxGeometry x="70" y="34" width="1100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="An issue is a spec. Argo Workflows on the hub claims a warm Kata micro-VM, a coder implements + tests, verification runs, a human approves on results — everything tears down on merge." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;fontColor=#6B7885;" vertex="1" parent="1">
          <mxGeometry x="72" y="74" width="1500" height="24" as="geometry" />
        </mxCell>

        <!-- Hub frame wraps only the on-hub orchestrated steps: claim, coder, verify -->
        <mxCell id="hubFrame" value="Hub  ·  Argo Workflows  ·  trusted (holds AWS IAM + GitHub App)" style="rounded=1;arcSize=3;html=1;fillColor=#FFFDF7;strokeColor=#FBA919;strokeWidth=2;dashed=1;dashPattern=8 5;verticalAlign=top;align=left;fontColor=#C77F0A;fontSize=14;fontStyle=1;fontFamily=Helvetica;spacingLeft=18;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="180" width="1180" height="240" as="geometry" />
        </mxCell>

        <!-- Spine nodes: single straight line, y-center = 300 (nodes 76 tall, y=262). Gaps ~200px so labels breathe. -->
        <mxCell id="issue" value="&lt;b&gt;GitHub Issue&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;the spec&lt;/font&gt;" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#FF9900;strokeColor=none;fontColor=#FFFFFF;fontSize=16;fontFamily=Helvetica;shadow=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="262" width="180" height="76" as="geometry" />
        </mxCell>

        <mxCell id="claim" value="&lt;b&gt;Claim&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;bind warm micro-VM&lt;/font&gt;" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D8DFE6;strokeWidth=1.5;fontColor=#16232E;fontSize=16;fontFamily=Helvetica;shadow=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="450" y="262" width="190" height="76" as="geometry" />
        </mxCell>

        <mxCell id="coder" value="&lt;b&gt;Coder&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;implement · build · test&lt;/font&gt;" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#FBA919;strokeColor=none;fontColor=#FFFFFF;fontSize=16;fontFamily=Helvetica;shadow=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="840" y="262" width="190" height="76" as="geometry" />
        </mxCell>
        <mxCell id="kata" value="Kata micro-VM  ·  no cloud creds" style="rounded=1;arcSize=40;html=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FBA919;strokeWidth=1;fontColor=#8A5A0A;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="840" y="348" width="190" height="28" as="geometry" />
        </mxCell>

        <mxCell id="verify" value="&lt;b&gt;Verify&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;holdout ≥90% ∥ security ∥ devops&lt;/font&gt;" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#12C88B;strokeWidth=2;fontColor=#16232E;fontSize=16;fontFamily=Helvetica;shadow=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1230" y="262" width="240" height="76" as="geometry" />
        </mxCell>

        <mxCell id="pr" value="&lt;b&gt;Pull Request&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;one live sticky status&lt;/font&gt;" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#12C88B;strokeColor=none;fontColor=#FFFFFF;fontSize=16;fontFamily=Helvetica;shadow=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1680" y="262" width="200" height="76" as="geometry" />
        </mxCell>

        <mxCell id="human" value="&lt;b&gt;Human&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;approve on results&lt;/font&gt;" style="rhombus;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#FBA919;strokeWidth=2;fontColor=#16232E;fontSize=15;fontFamily=Helvetica;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="2090" y="248" width="200" height="104" as="geometry" />
        </mxCell>

        <mxCell id="done" value="&lt;b&gt;Merge + Teardown&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;delete sandbox · PVC · eval&lt;/font&gt;" style="rounded=1;arcSize=16;html=1;whiteSpace=wrap;fillColor=#12C88B;strokeColor=none;fontColor=#FFFFFF;fontSize=16;fontFamily=Helvetica;shadow=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2400" y="262" width="200" height="76" as="geometry" />
        </mxCell>

        <!-- Straight horizontal spine. Minimal labels, each centered in a wide gap. -->
        <mxCell id="s1" style="html=1;rounded=0;strokeColor=#B7C0C9;strokeWidth=2.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="issue" target="claim"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s2" value="SandboxClaim" style="html=1;rounded=0;strokeColor=#B7C0C9;strokeWidth=2.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontColor=#6B7885;fontSize=12;fontFamily=Helvetica;" edge="1" parent="1" source="claim" target="coder"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s3" value="tests green" style="html=1;rounded=0;strokeColor=#B7C0C9;strokeWidth=2.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontColor=#6B7885;fontSize=12;fontFamily=Helvetica;" edge="1" parent="1" source="coder" target="verify"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s4" value="pass → open PR" style="html=1;rounded=0;strokeColor=#12C88B;strokeWidth=2.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontColor=#0E9A6C;fontSize=12;fontStyle=1;fontFamily=Helvetica;" edge="1" parent="1" source="verify" target="pr"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s5" value="review" style="html=1;rounded=0;strokeColor=#B7C0C9;strokeWidth=2.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontColor=#6B7885;fontSize=12;fontFamily=Helvetica;" edge="1" parent="1" source="pr" target="human"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="s6" value="approve" style="html=1;rounded=0;strokeColor=#12C88B;strokeWidth=3;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontColor=#0E9A6C;fontSize=12;fontStyle=1;fontFamily=Helvetica;" edge="1" parent="1" source="human" target="done"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Feedback loop routed in the empty band well below the spine (band y=500), clear of all nodes/labels -->
        <mxCell id="fb" value="changes requested  ·  bounded N rounds" style="html=1;rounded=1;strokeColor=#EE9AAE;strokeWidth=2;dashed=1;dashPattern=7 5;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;fontColor=#B23A55;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="human" target="coder">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2190" y="500" />
              <mxPoint x="935" y="500" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
