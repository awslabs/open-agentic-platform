<mxfile host="app.diagrams.net" agent="claude-code" version="24.0.0">
  <diagram name="Flow A — Warm-pool cycling" id="warmpool">
    <mxGraphModel dx="1700" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="620" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Warm-pool cycling  ·  claim ↔ refill ↔ scale-to-zero" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontFamily=Helvetica;fontColor=#16232E;" vertex="1" parent="1">
          <mxGeometry x="70" y="34" width="1200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="The operator keeps a steady buffer of idle micro-VMs so a consumer binds a ready VM instantly. On claim it refills; idle VMs scale to zero (PVC kept); done VMs are retired." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;fontColor=#6B7885;" vertex="1" parent="1">
          <mxGeometry x="72" y="74" width="1550" height="24" as="geometry" />
        </mxCell>

        <!-- States on a straight spine, y-center = 300 -->
        <mxCell id="prov" value="&lt;b&gt;Provisioning&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;pool below target&lt;/font&gt;" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#D8DFE6;strokeWidth=1.5;fontColor=#16232E;fontSize=15;fontFamily=Helvetica;shadow=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="70" y="262" width="200" height="76" as="geometry" />
        </mxCell>
        <mxCell id="idle" value="&lt;b&gt;Idle&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;booted · replicas=1 · unclaimed&lt;/font&gt;" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#FBA919;strokeColor=none;fontColor=#FFFFFF;fontSize=15;fontFamily=Helvetica;shadow=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="470" y="262" width="230" height="76" as="geometry" />
        </mxCell>
        <mxCell id="claimed" value="&lt;b&gt;Claimed&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;bound to a SandboxClaim&lt;/font&gt;" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#12C88B;strokeColor=none;fontColor=#FFFFFF;fontSize=15;fontFamily=Helvetica;shadow=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="900" y="262" width="230" height="76" as="geometry" />
        </mxCell>
        <mxCell id="retired" value="&lt;b&gt;Retired&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;delete Sandbox + PVC&lt;/font&gt;" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#EFAAB8;strokeWidth=1.5;fontColor=#8A2540;fontSize=15;fontFamily=Helvetica;shadow=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1330" y="262" width="230" height="76" as="geometry" />
        </mxCell>

        <!-- Paused: below Idle -->
        <mxCell id="paused" value="&lt;b&gt;Paused&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;idle TTL · replicas=0 · PVC kept&lt;/font&gt;" style="rounded=1;arcSize=18;html=1;whiteSpace=wrap;fillColor=#F6F8FA;strokeColor=#C3CDD7;strokeWidth=1.5;fontColor=#5B6875;fontSize=15;fontFamily=Helvetica;shadow=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="470" y="450" width="230" height="76" as="geometry" />
        </mxCell>

        <!-- Refill note under Claimed -->
        <mxCell id="refill" value="on claim → operator provisions a REFILL so the buffer stays at target" style="rounded=1;arcSize=30;html=1;whiteSpace=wrap;fillColor=#F3FBF8;strokeColor=#9FE3C9;strokeWidth=1;fontColor=#0E7A56;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="820" y="450" width="390" height="46" as="geometry" />
        </mxCell>

        <!-- Spine edges -->
        <mxCell id="w1" value="booted" style="html=1;rounded=0;strokeColor=#B7C0C9;strokeWidth=2.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontColor=#6B7885;fontSize=12;fontFamily=Helvetica;" edge="1" parent="1" source="prov" target="idle"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="w2" value="SandboxClaim binds" style="html=1;rounded=0;strokeColor=#12C88B;strokeWidth=2.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontColor=#0E9A6C;fontSize=12;fontStyle=1;fontFamily=Helvetica;" edge="1" parent="1" source="idle" target="claimed"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="w3" value="consumer done" style="html=1;rounded=0;strokeColor=#B7C0C9;strokeWidth=2.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontColor=#6B7885;fontSize=12;fontFamily=Helvetica;" edge="1" parent="1" source="claimed" target="retired"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Idle <-> Paused vertical -->
        <mxCell id="w4" value="idle TTL" style="html=1;rounded=0;strokeColor=#B7C0C9;strokeWidth=2.5;endArrow=block;endFill=1;exitX=0.35;exitY=1;entryX=0.35;entryY=0;fontColor=#6B7885;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="idle" target="paused"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="w5" value="demand returns" style="html=1;rounded=0;strokeColor=#B7C0C9;strokeWidth=2.5;endArrow=block;endFill=1;exitX=0.7;exitY=0;entryX=0.7;entryY=1;fontColor=#6B7885;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="paused" target="idle"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Claimed -> Idle (released, recyclable) routed above the spine -->
        <mxCell id="w6" value="released · recyclable" style="html=1;rounded=1;strokeColor=#B7C0C9;strokeWidth=2;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;fontColor=#6B7885;fontSize=12;fontFamily=Helvetica;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="claimed" target="idle">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="1015" y="210" /><mxPoint x="585" y="210" /></Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
